{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studynotes.local/contracts/editor-document-manifest.schema.json",
  "title": "StudyNotes editor document manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "title",
    "updatedAt",
    "locked",
    "currentGenerationID",
    "contentFingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": ["note", "markdown", "html", "webArticle", "pdf", "image"]
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "locked": {
      "type": "boolean"
    },
    "currentGenerationID": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentFingerprint": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "derivedRebuildPending": {
      "type": "boolean",
      "default": false
    },
    "contentVersionID": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
